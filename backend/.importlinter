[importlinter]
root_packages =
    apps
    config
    engine
include_external_packages = True

[importlinter:contract:app-layers]
name = Inside each app, api depends on services and selectors, which depend on models
type = layers
containers =
    apps.*
layers =
    (api)
    (services) | (selectors)
    (models)

[importlinter:contract:api-is-the-edge]
name = Only config and other api packages import an app's api package
type = forbidden
source_modules =
    apps.*.models
    apps.*.services
    apps.*.selectors
    apps.*.admin
forbidden_modules =
    apps.*.api

[importlinter:contract:domain-order]
name = Apps depend only on apps below them in the domain order (see .agents/backend.md)
type = layers
containers =
    apps
layers =
    (evals)
    (runs)
    (agents)
    (knowledge)
    (tools)
    integrations
    (providers)
    accounts

[importlinter:contract:engine-is-plain-python]
name = The engine never imports Django, Django REST framework, or the apps (see .agents/backend.md)
type = forbidden
source_modules =
    engine
forbidden_modules =
    django
    rest_framework
    apps
