POSTGRES_DB=nextsci_agents
POSTGRES_USER=nextsci
POSTGRES_PASSWORD=nextsci
# Used when running Django outside Docker; compose sets these to db:5432 itself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for Postgres; change if a local Postgres already uses 5432.
POSTGRES_HOST_PORT=5432
DJANGO_SECRET_KEY=django-insecure-dev-only-not-for-production-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# OpenRouter, for the chat on the Agents screen. Leave the key empty until you have one.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Empty means openrouter/auto.
OPENROUTER_MODEL=
