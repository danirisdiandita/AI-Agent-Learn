POSTGRES_DB=nextsci_agents
POSTGRES_USER=nextsci
POSTGRES_PASSWORD=nextsci
# Used when running Django outside Docker; compose sets these to db:5432 itself.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host port for Postgres; change if a local Postgres already uses 5432.
POSTGRES_HOST_PORT=5432
DJANGO_SECRET_KEY=django-insecure-dev-only-not-for-production-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# OpenRouter, for the chat on the Agents screen. Leave the key empty until you have one.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models. Empty means openrouter/auto.
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Google Calendar integration. Leave the client values empty to keep it off.
# scripts/make-oauth-client.sh <project-id> does these steps with gcloud and fills them in here.
# 1. In Google Cloud Console, enable the Google Calendar API for your project.
# 2. Under APIs & Services > Credentials, create an OAuth client ID of type "Web application".
# 3. Add the redirect URI below to its authorized redirect URIs, exactly as written.
# 4. Copy the client ID and secret here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where Google sends the browser after consent: the dashboard origin, which forwards /api to Django.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5174/api/v1/integrations/google-calendar/callback/
# Encrypts stored OAuth tokens. Changing it makes stored connections unreadable. Generate one with:
#   backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
